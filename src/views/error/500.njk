{# Localized 500 page rendered inside the application shell. Carries the
   request correlation id so support can trace the failure; in production the
   body carries no stack trace, SQL, or filesystem path. #}
{% from 'partials/components.njk' import pageHeader, card, emptyState %}
{{ pageHeader(title) }}
<div class="max-w-3xl">
  {% call card('p-6') %}
    {{ emptyState(title, message, 'alert') }}
  {% endcall %}
  <p class="mt-4 text-xs font-data text-slate-400">{{ t.translate('error.correlation_id') }}: {{ correlationId }}</p>
  <p class="mt-3 text-sm"><a href="/{{ locale }}" class="touch-target text-blue-300 hover:text-blue-200 font-medium">{{ t.translate('error.back_home') }}</a></p>
</div>
