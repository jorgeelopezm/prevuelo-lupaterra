{# Record a maintenance completion (maintenance-tracking capability): rolls a
   recurring item forward or closes a non-recurring one, and keeps the
   previous completion visible as history. #}
{% from 'partials/components.njk' import pageHeader, card %}

{{ pageHeader(title) }}

{% call card('p-4 max-w-lg') %}
  <p class="text-sm text-slate-300 mb-4">{{ item.description }}</p>
<form method="post" action="{{ action }}" class="space-y-4">
  <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
  {%- if errors.general %}<p class="text-[11px] text-red-300">{{ errors.general }}</p>{% endif %}

  <div class="grid grid-cols-2 gap-4">
    <div>
      <label for="completedOn" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.mx_completed_on') }}</label>
      <input type="date" id="completedOn" name="completedOn" value="{{ values.completedOn }}" class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white font-data">
      {%- if errors.completedOn %}<p class="mt-1 text-[11px] text-red-300">{{ errors.completedOn }}</p>{% endif %}
    </div>
    <div>
      <label for="completedAtHours" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.mx_completed_at_hours') }}</label>
      <input type="text" inputmode="decimal" id="completedAtHours" name="completedAtHours" value="{{ values.completedAtHours }}" class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white font-data">
    </div>
    <div class="col-span-2">
      <label for="reference" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.mx_reference') }}</label>
      <input type="text" id="reference" name="reference" value="{{ values.reference }}" class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white">
    </div>
  </div>

  <div class="flex gap-3">
    <button type="submit" class="touch-target px-4 rounded bg-accent text-white text-sm font-semibold">{{ t.translate('fleet.mx_complete_confirm') }}</button>
    <a href="{{ cancelHref }}" class="touch-target inline-flex items-center px-4 rounded border border-edge text-sm text-slate-300">{{ t.translate('fleet.cancel') }}</a>
  </div>
</form>
{% endcall %}
