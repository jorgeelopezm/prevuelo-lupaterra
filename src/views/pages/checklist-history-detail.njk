{# Read-only completed-run detail (checklist-runs: "Opening a completed run"
   — its recorded items shown as confirmed, read-only, with no control that
   would modify them). Renders the run's own snapshot rows, never the
   checklist's current items. #}
{% from 'partials/components.njk' import pageHeader, card %}

{{ pageHeader(run.checklistName) }}

{% call card('p-4 mb-4') %}
  {%- if run.flightIntent %}
  <div class="text-sm text-white font-data mb-1">{{ run.flightIntent.departureIcao }} &rarr; {{ run.flightIntent.destinationIcao }}</div>
  {%- endif %}
  <p class="text-sm font-semibold text-emerald-300">{{ t.translate('checklist.all_done') }}</p>
  <p class="text-xs text-slate-500 font-data mt-1">{{ run.completedAt | intlUtcDateTime }}</p>
{% endcall %}

{% call card('p-4') %}
  <ol class="space-y-2">
    {%- for item in run.items %}
    <li class="flex items-center gap-3 text-sm">
      <span class="w-5 h-5 rounded border flex items-center justify-center shrink-0 bg-emerald-600 border-emerald-500" aria-hidden="true">&#10003;</span>
      <span class="text-slate-300">{{ item.text }}</span>
      <span class="sr-only">{{ t.translate('checklist.item_confirmed') }}</span>
    </li>
    {%- endfor %}
  </ol>
{% endcall %}

<div class="mt-4">
  <a href="{{ backHref }}" class="touch-target inline-flex items-center px-4 rounded border border-edge text-sm text-slate-300">&larr; {{ t.translate('checklist.view_history') }}</a>
</div>
