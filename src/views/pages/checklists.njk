{# Checklists screen (aircraft-checklists / checklist-runs capabilities):
   fleet -> checklist selector -> items, as progressive disclosure on phone
   (design.md decision 2) and three side-by-side panes at lg:. The URL always
   names the deepest selected level (vm.level); all three panes render from
   this one view model, whichever level requested it. #}
{% from 'partials/components.njk' import pageHeader, card, emptyState, badge %}
{% from 'partials/icons.njk' import icon %}

{{ pageHeader(title) }}

<div class="lg:flex lg:gap-4 lg:items-start">

  {# --- Fleet pane -------------------------------------------------- #}
  <div class="{% if vm.level !== 'fleet' %}hidden lg:block{% endif %} lg:w-44 shrink-0">
    {% call card('p-3') %}
      {%- if vm.fleet.empty %}
        {{ emptyState(t.translate('checklist.no_aircraft_title'), t.translate('checklist.no_aircraft_message'), 'plane') }}
        <div class="flex justify-center">
          <a href="{{ vm.fleet.newAircraftHref }}" class="touch-target inline-flex items-center px-4 rounded bg-accent text-white text-sm font-semibold">{{ t.translate('checklist.record_aircraft') }}</a>
        </div>
      {%- else %}
      <ul class="space-y-1">
        {%- for a in vm.fleet.aircraft %}
        <li>
          <a href="{{ a.href }}" class="touch-target flex items-center justify-between gap-2 px-3 rounded {% if a.selected %}bg-blue-600/20 text-blue-300{% else %}text-slate-300 hover:bg-surface{% endif %}">
            <span class="font-data text-sm">{{ a.registration }}</span>
            {%- if a.isActiveAircraft %}{{ badge(t.translate('fleet.active'), 'neutral') }}{% endif %}
          </a>
        </li>
        {%- endfor %}
      </ul>
      {%- endif %}
    {% endcall %}
  </div>

  {# --- Selector pane ------------------------------------------------ #}
  {%- if vm.selector %}
  <div class="{% if vm.level !== 'selector' %}hidden lg:block{% endif %} lg:w-64 shrink-0 mt-4 lg:mt-0">
    <div class="lg:hidden mb-3">
      <a href="{{ vm.selector.backHref }}" class="touch-target inline-flex items-center px-3 rounded border border-edge text-xs text-slate-300">&larr; {{ t.translate('checklist.back_to_fleet') }}</a>
    </div>
    {% call card('p-3') %}
      <h2 class="text-sm font-bold text-white font-data mb-3">{{ vm.selector.aircraftRegistration }}</h2>

      {%- if vm.selector.formError %}
      <p class="text-[11px] text-red-300 mb-3">{{ vm.selector.formError }}</p>
      {%- endif %}

      {%- if vm.selector.empty %}
        {{ emptyState(t.translate('checklist.no_checklists_title'), '', 'list') }}
      {%- else %}
      <div class="mb-4">
        <h3 class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-2">{{ t.translate('checklist.group_normal') }}</h3>
        <ul class="space-y-1">
          {%- for c in vm.selector.normal %}
          <li>
            <a href="{{ c.href }}" class="touch-target flex items-center justify-between gap-2 px-3 rounded text-sm text-slate-200 hover:bg-surface">
              <span class="flex items-center gap-2">
                {{ c.name }}
                {%- if c.isPreflight %}{{ badge(t.translate('checklist.preflight_badge'), 'neutral') }}{% endif %}
              </span>
              {%- if c.isTemplate %}<span class="text-[10px] text-slate-500">{{ t.translate('checklist.generic_badge') }}</span>{% endif %}
            </a>
          </li>
          {%- endfor %}
        </ul>
      </div>
      <div>
        <h3 class="text-[10px] font-semibold text-red-400 uppercase tracking-widest mb-2">{{ t.translate('checklist.group_emergency') }}</h3>
        <ul class="space-y-1">
          {%- for c in vm.selector.emergency %}
          <li>
            <a href="{{ c.href }}" class="touch-target flex items-center justify-between gap-2 px-3 rounded text-sm text-red-200 hover:bg-red-950/30">
              <span>{{ c.name }}</span>
              {%- if c.isTemplate %}<span class="text-[10px] text-slate-500">{{ t.translate('checklist.generic_badge') }}</span>{% endif %}
            </a>
          </li>
          {%- endfor %}
        </ul>
      </div>
      {%- endif %}

      <form method="post" action="{{ vm.selector.newChecklistHref }}" class="mt-4 pt-3 border-t border-edge space-y-2">
        <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
        <label class="block text-[10px] font-semibold text-slate-400 uppercase tracking-widest" for="new-checklist-name">{{ t.translate('checklist.new_checklist_name') }}</label>
        <input id="new-checklist-name" type="text" name="name" class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white">
        <select name="kind" class="touch-target w-full rounded border border-edge bg-surface px-2 text-sm text-white">
          <option value="normal">{{ t.translate('checklist.group_normal') }}</option>
          <option value="emergency">{{ t.translate('checklist.group_emergency') }}</option>
        </select>
        <button type="submit" class="touch-target w-full rounded bg-accent text-white text-sm font-semibold">{{ t.translate('checklist.add_checklist') }}</button>
      </form>

      <div class="mt-3 text-center">
        <a href="{{ vm.selector.historyHref }}" class="touch-target inline-flex items-center text-xs text-slate-400 underline">{{ t.translate('checklist.view_history') }}</a>
      </div>
    {% endcall %}
  </div>
  {%- endif %}

  {# --- Items pane ------------------------------------------------ #}
  {%- if vm.items %}
  <div class="{% if vm.level !== 'items' %}hidden lg:block{% endif %} flex-1 mt-4 lg:mt-0 min-w-0">
    <div class="lg:hidden mb-3">
      <a href="{{ vm.items.backHref }}" class="touch-target inline-flex items-center px-3 rounded border border-edge text-xs text-slate-300">&larr; {{ t.translate('checklist.back_to_selector') }}</a>
    </div>

    {%- if vm.items.formError %}
    {% call card('p-3 mb-3') %}<p class="text-[11px] text-red-300">{{ vm.items.formError }}</p>{% endcall %}
    {%- endif %}

    {%- if vm.items.isTemplate %}
    {% call card('p-3 mb-3 border-amber-700/60') %}
      <p class="text-xs text-amber-300">{{ t.translate('checklist.generic_caveat') }}</p>
    {% endcall %}
    {%- endif %}

    {%- if vm.items.kind === 'emergency' %}
    {% call card('p-4 mb-4 bg-red-950/40 border-red-700/60') %}
      <div class="flex items-center gap-2 mb-2">
        {{ icon('alert') }}
        <h2 class="text-sm font-bold text-red-200">{{ vm.items.checklistName }}</h2>
      </div>
      <p class="text-xs text-red-200 mb-1">{{ t.translate('checklist.emergency_banner') }}</p>
      <p class="text-xs text-red-300/80">{{ t.translate('checklist.connectivity_caveat') }}</p>
    {% endcall %}
      {%- if vm.items.hasItems %}
      <ol class="space-y-2">
        {%- for item in vm.items.manageItems %}
        <li class="text-sm text-slate-200 border-b border-edge/50 pb-2 last:border-0">{{ loop.index }}. {{ item.text }}</li>
        {%- endfor %}
      </ol>
      {%- else %}
      {% call card('p-4') %}{{ emptyState(t.translate('checklist.no_items_title'), '', 'list') }}{% endcall %}
      {%- endif %}
    {%- elif vm.items.runState === 'no-intent' %}
      {% call card('p-4 mb-4') %}
        <h2 class="text-sm font-bold text-white mb-2">{{ vm.items.checklistName }}</h2>
        <p class="text-sm text-slate-400 mb-3">{{ t.translate('checklist.no_intent_message') }}</p>
        <a href="{{ vm.items.planFlightHref }}" class="touch-target inline-flex items-center px-4 rounded bg-accent text-white text-sm font-semibold">{{ t.translate('checklist.plan_flight') }}</a>
      {% endcall %}
      <ol class="space-y-2">
        {%- for item in vm.items.manageItems %}
        <li class="text-sm text-slate-300 border-b border-edge/50 pb-2 last:border-0">{{ loop.index }}. {{ item.text }}</li>
        {%- endfor %}
      </ol>
    {%- elif vm.items.runState === 'empty' %}
      {% call card('p-4') %}
        <h2 class="text-sm font-bold text-white mb-2">{{ vm.items.checklistName }}</h2>
        {{ emptyState(t.translate('checklist.no_items_title'), '', 'list') }}
      {% endcall %}
    {%- elif vm.items.runState === 'active' %}
      {% set progress = { checkedCount: vm.items.checkedCount, totalCount: vm.items.totalCount, completed: vm.items.completed, resetHref: vm.items.resetHref } %}
      {% call card('p-4 mb-4') %}
        <h2 class="text-sm font-bold text-white mb-3">{{ vm.items.checklistName }}</h2>
        <div id="checklist-progress">
          {%- include 'partials/checklist-progress.njk' %}
        </div>
        <ul class="space-y-1 mt-3">
          {%- for item in vm.items.runItems %}
          <li id="checklist-item-{{ item.id }}">
            {%- include 'partials/checklist-item.njk' %}
          </li>
          {%- endfor %}
        </ul>
      {% endcall %}
    {%- endif %}

    {# --- Library management (available for every kind and state) --- #}
    {% call card('p-4') %}
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-xs font-semibold text-slate-300 uppercase tracking-wide">{{ t.translate('checklist.manage_title') }}</h3>
        <div class="flex gap-2">
          <form method="post" action="{{ vm.items.moveUpHref }}"><input type="hidden" name="csrfToken" value="{{ csrfToken }}"><button type="submit" class="touch-target px-2 rounded border border-edge text-xs text-slate-300">&uarr;</button></form>
          <form method="post" action="{{ vm.items.moveDownHref }}"><input type="hidden" name="csrfToken" value="{{ csrfToken }}"><button type="submit" class="touch-target px-2 rounded border border-edge text-xs text-slate-300">&darr;</button></form>
        </div>
      </div>

      <form method="post" action="{{ vm.items.renameHref }}" class="flex gap-2 mb-3">
        <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
        <input type="text" name="name" value="{{ vm.items.checklistName }}" class="touch-target flex-1 rounded border border-edge bg-surface px-3 text-sm text-white">
        <button type="submit" class="touch-target px-3 rounded border border-edge text-xs text-slate-300">{{ t.translate('checklist.rename') }}</button>
      </form>

      {%- if vm.items.preflightHref %}
      <form method="post" action="{{ vm.items.preflightHref }}" class="mb-3">
        <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
        <button type="submit" class="touch-target px-3 rounded border border-edge text-xs {% if vm.items.isPreflight %}text-slate-500{% else %}text-slate-300{% endif %}" {% if vm.items.isPreflight %}disabled{% endif %}>
          {%- if vm.items.isPreflight %}{{ t.translate('checklist.is_preflight') }}{% else %}{{ t.translate('checklist.set_preflight') }}{% endif %}
        </button>
      </form>
      {%- endif %}

      <ul class="space-y-2 mb-3">
        {%- for item in vm.items.manageItems %}
        <li class="flex items-center gap-2">
          <form method="post" action="{{ item.updateHref }}" class="flex-1 flex gap-2">
            <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
            <input type="text" name="text" value="{{ item.text }}" class="touch-target flex-1 rounded border border-edge bg-surface px-2 text-sm text-white">
            <button type="submit" class="touch-target px-2 rounded border border-edge text-xs text-slate-300">{{ t.translate('checklist.save') }}</button>
          </form>
          <form method="post" action="{{ item.moveUpHref }}"><input type="hidden" name="csrfToken" value="{{ csrfToken }}"><button type="submit" class="touch-target px-2 rounded border border-edge text-xs text-slate-300">&uarr;</button></form>
          <form method="post" action="{{ item.moveDownHref }}"><input type="hidden" name="csrfToken" value="{{ csrfToken }}"><button type="submit" class="touch-target px-2 rounded border border-edge text-xs text-slate-300">&darr;</button></form>
          <form method="post" action="{{ item.deleteHref }}"><input type="hidden" name="csrfToken" value="{{ csrfToken }}"><button type="submit" class="touch-target px-2 rounded border border-edge text-xs text-red-300">{{ t.translate('checklist.remove') }}</button></form>
        </li>
        {%- endfor %}
      </ul>

      <form method="post" action="{{ vm.items.addItemHref }}" class="flex gap-2">
        <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
        <input type="text" name="text" placeholder="{{ t.translate('checklist.new_item_placeholder') }}" class="touch-target flex-1 rounded border border-edge bg-surface px-3 text-sm text-white">
        <button type="submit" class="touch-target px-3 rounded bg-accent text-white text-xs font-semibold">{{ t.translate('checklist.add_item') }}</button>
      </form>

      <form method="post" action="{{ vm.items.deleteHref }}" class="mt-3 pt-3 border-t border-edge">
        <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
        <button type="submit" class="touch-target px-3 rounded border border-red-700/60 text-xs text-red-300">{{ t.translate('checklist.delete_checklist') }}</button>
      </form>
    {% endcall %}
  </div>
  {%- endif %}

</div>
