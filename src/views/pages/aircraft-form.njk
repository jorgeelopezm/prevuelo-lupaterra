{# Add/edit aircraft form (aircraft-fleet capability). Plain POST + redirect —
   no JavaScript required; a validation failure re-renders this same partial
   with field-level messages and the submitted values preserved, status 422. #}
{% from 'partials/components.njk' import pageHeader, card %}

{{ pageHeader(title) }}

{% call card('p-4 max-w-2xl') %}
<form method="post" action="{{ action }}" class="space-y-4">
  <input type="hidden" name="csrfToken" value="{{ csrfToken }}">

  <div>
    <label for="registration" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.registration') }}</label>
    <input type="text" id="registration" name="registration" value="{{ values.registration }}"
      class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white font-data uppercase" required>
    {%- if errors.registration %}<p class="mt-1 text-[11px] text-red-300">{{ errors.registration }}</p>{% endif %}
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div>
      <label for="icaoType" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.icao_type') }}</label>
      <input type="text" id="icaoType" name="icaoType" value="{{ values.icaoType }}"
        class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white font-data uppercase" required>
      {%- if errors.icaoType %}<p class="mt-1 text-[11px] text-red-300">{{ errors.icaoType }}</p>{% endif %}
    </div>
    <div>
      <label for="manufacturer" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.manufacturer') }}</label>
      <input type="text" id="manufacturer" name="manufacturer" value="{{ values.manufacturer }}"
        class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white" required>
      {%- if errors.manufacturer %}<p class="mt-1 text-[11px] text-red-300">{{ errors.manufacturer }}</p>{% endif %}
    </div>
    <div>
      <label for="model" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.model') }}</label>
      <input type="text" id="model" name="model" value="{{ values.model }}"
        class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white" required>
      {%- if errors.model %}<p class="mt-1 text-[11px] text-red-300">{{ errors.model }}</p>{% endif %}
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label for="serialNumber" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.serial_number') }}</label>
      <input type="text" id="serialNumber" name="serialNumber" value="{{ values.serialNumber }}"
        class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white">
    </div>
    <div>
      <label for="classCategory" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.class_category') }}</label>
      <input type="text" id="classCategory" name="classCategory" value="{{ values.classCategory }}"
        class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white">
    </div>
    <div>
      <label for="engine" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.engine') }}</label>
      <input type="text" id="engine" name="engine" value="{{ values.engine }}"
        class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white">
    </div>
    <div>
      <label for="propeller" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.propeller') }}</label>
      <input type="text" id="propeller" name="propeller" value="{{ values.propeller }}"
        class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white">
    </div>
    <div>
      <label for="yearOfManufacture" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.year') }}</label>
      <input type="number" id="yearOfManufacture" name="yearOfManufacture" value="{{ values.yearOfManufacture }}"
        class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white font-data">
    </div>
    <div>
      <label for="homeBase" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.home_base') }}</label>
      <input type="text" id="homeBase" name="homeBase" value="{{ values.homeBase }}"
        class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white font-data uppercase">
    </div>
    <div class="sm:col-span-2">
      <label for="nickname" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.nickname') }}</label>
      <input type="text" id="nickname" name="nickname" value="{{ values.nickname }}"
        class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white">
    </div>
  </div>

  <fieldset class="border border-edge rounded p-3">
    <legend class="text-xs font-semibold text-slate-300 px-1">{{ t.translate('fleet.opening_readings') }}</legend>
    <p class="text-[11px] text-slate-500 mb-3">{{ t.translate('fleet.opening_readings_help') }}</p>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <div>
        <label for="openingAirframeHours" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.opening_airframe_hours') }}</label>
        <input type="text" inputmode="decimal" id="openingAirframeHours" name="openingAirframeHours" value="{{ values.openingAirframeHours }}"
          class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white font-data">
        {%- if errors.openingAirframeHours %}<p class="mt-1 text-[11px] text-red-300">{{ errors.openingAirframeHours }}</p>{% endif %}
      </div>
      <div>
        <label for="openingEngineHours" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.opening_engine_hours') }}</label>
        <input type="text" inputmode="decimal" id="openingEngineHours" name="openingEngineHours" value="{{ values.openingEngineHours }}"
          class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white font-data">
        {%- if errors.openingEngineHours %}<p class="mt-1 text-[11px] text-red-300">{{ errors.openingEngineHours }}</p>{% endif %}
      </div>
      <div>
        <label for="openingTachHours" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.opening_tach_hours') }}</label>
        <input type="text" inputmode="decimal" id="openingTachHours" name="openingTachHours" value="{{ values.openingTachHours }}"
          class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white font-data">
        {%- if errors.openingTachHours %}<p class="mt-1 text-[11px] text-red-300">{{ errors.openingTachHours }}</p>{% endif %}
      </div>
      <div>
        <label for="openingLandings" class="block text-xs font-semibold text-slate-300 mb-1">{{ t.translate('fleet.opening_landings') }}</label>
        <input type="number" min="0" id="openingLandings" name="openingLandings" value="{{ values.openingLandings }}"
          class="touch-target w-full rounded border border-edge bg-surface px-3 text-sm text-white font-data">
        {%- if errors.openingLandings %}<p class="mt-1 text-[11px] text-red-300">{{ errors.openingLandings }}</p>{% endif %}
      </div>
    </div>
  </fieldset>

  <div class="flex gap-3">
    <button type="submit" class="touch-target px-4 rounded bg-accent text-white text-sm font-semibold">
      {%- if isEdit %}{{ t.translate('fleet.save') }}{% else %}{{ t.translate('fleet.add_aircraft') }}{% endif %}
    </button>
  </div>
</form>
{% endcall %}
