{# IMSAFE/PAVE questionnaire (preflight-risk-assessment spec: "Domains are
   presented" / "Incomplete questionnaire cannot be submitted"). Every
   pilot-answered item is a fixed 3-option segmented control, styled after the
   `diseno/` prototype's RiskAssessment screen — three equal-width boxes per
   question, colored emerald/amber/red only once selected (no JavaScript: the
   selected look comes from `has-[:checked]` on the hidden radio). The
   Aircraft domain's items are read-only, auto-scored fields, visibly
   distinguished with the "auto" badge and never presented as a control. #}
{% from 'partials/components.njk' import pageHeader, card, badge %}

{% macro optionBox(name, index, label, checked) %}
{%- if index === 0 %}
<label class="flex-1 touch-target flex items-center justify-center text-center px-2 rounded border border-edge text-xs text-slate-500 cursor-pointer transition-colors hover:border-slate-500 hover:text-slate-300 has-[:checked]:bg-emerald-900/50 has-[:checked]:border-emerald-600/60 has-[:checked]:text-emerald-300">
  <input type="radio" name="{{ name }}" value="{{ index }}" class="sr-only" {% if checked %}checked{% endif %} required>
  {{ label }}
</label>
{%- elif index === 1 %}
<label class="flex-1 touch-target flex items-center justify-center text-center px-2 rounded border border-edge text-xs text-slate-500 cursor-pointer transition-colors hover:border-slate-500 hover:text-slate-300 has-[:checked]:bg-amber-900/50 has-[:checked]:border-amber-600/60 has-[:checked]:text-amber-300">
  <input type="radio" name="{{ name }}" value="{{ index }}" class="sr-only" {% if checked %}checked{% endif %} required>
  {{ label }}
</label>
{%- else %}
<label class="flex-1 touch-target flex items-center justify-center text-center px-2 rounded border border-edge text-xs text-slate-500 cursor-pointer transition-colors hover:border-slate-500 hover:text-slate-300 has-[:checked]:bg-red-900/50 has-[:checked]:border-red-600/60 has-[:checked]:text-red-300">
  <input type="radio" name="{{ name }}" value="{{ index }}" class="sr-only" {% if checked %}checked{% endif %} required>
  {{ label }}
</label>
{%- endif %}
{% endmacro %}

{% macro questionGroup(key, unanswered, values) %}
{%- set options = t.translateArray('risk.l_' + key) %}
<div class="mb-4 last:mb-0">
  <p class="text-sm text-slate-300 mb-2">{{ t.translate('risk.q_' + key) }}</p>
  <div class="flex gap-2">
    {%- for option in options %}
    {{ optionBox(key, loop.index0, option, values[key] === loop.index0|string) }}
    {%- endfor %}
  </div>
  {%- if key in unanswered %}<p class="mt-1 text-[11px] text-red-300">{{ t.translate('risk.submit_incomplete') }}</p>{% endif %}
</div>
{% endmacro %}

{{ pageHeader(title, subtitle) }}

<p class="text-xs text-slate-400 mb-3 font-data">{{ flightIntent.departureIcao }} &rarr; {{ flightIntent.destinationIcao }} &middot; {{ flightIntent.plannedDate }}</p>

{%- if error %}<p class="text-[11px] text-red-300 mb-3">{{ error }}</p>{% endif %}

<form method="post" action="{{ action }}" class="space-y-4">
  <input type="hidden" name="csrfToken" value="{{ csrfToken }}">

  {% call card('p-4') %}
  <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">{{ t.translate('risk.d_pilot') }}</div>
  {%- for key in pilotItemKeys %}
  {{ questionGroup(key, unanswered, values) }}
  {%- endfor %}
  {% endcall %}

  {% call card('p-4') %}
  <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3 flex items-center gap-2">{{ t.translate('risk.d_aircraft') }} {{ badge(t.translate('risk.auto_scored'), 'neutral') }}</div>
  <div class="space-y-2 text-xs">
    <div class="flex items-center justify-between">
      <span class="text-slate-300">{{ t.translate('risk.factor.engine_exceedance') }}</span>
      <span class="font-data {% if aircraftSnapshot.engineExceedance === true %}text-red-300{% elif aircraftSnapshot.engineExceedance === null %}text-slate-500{% else %}text-slate-300{% endif %}">
        {%- if aircraftSnapshot.engineExceedance === null %}{{ t.translate('risk.no_telemetry') }}{% elif aircraftSnapshot.engineExceedance %}{{ t.translate('risk.exceedance_yes') }}{% else %}{{ t.translate('risk.exceedance_ok') }}{% endif -%}
      </span>
    </div>
    <div class="flex items-center justify-between">
      <span class="text-slate-300">{{ t.translate('risk.factor.fuel_status') }}</span>
      <span class="font-data {% if aircraftSnapshot.fuelStatus === 'low' %}text-red-300{% elif aircraftSnapshot.fuelStatus === null %}text-slate-500{% else %}text-slate-300{% endif %}">
        {%- if aircraftSnapshot.fuelStatus === null %}{{ t.translate('risk.no_telemetry') }}{% elif aircraftSnapshot.fuelStatus === 'low' %}{{ t.translate('risk.fuel_low') }}{% else %}{{ t.translate('risk.fuel_ok') }}{% endif -%}
      </span>
    </div>
    <div class="flex items-center justify-between">
      <span class="text-slate-300">{{ t.translate('risk.factor.hours_to_maintenance') }}</span>
      <span class="font-data {% if aircraftSnapshot.hoursToNextMaintenance === null %}text-slate-500{% else %}text-slate-300{% endif %}">
        {%- if aircraftSnapshot.hoursToNextMaintenance === null %}{{ t.translate('risk.no_telemetry') }}{% else %}{{ aircraftSnapshot.hoursToNextMaintenance | round(1) }}{% endif -%}
      </span>
    </div>
  </div>
  {% endcall %}

  {% call card('p-4') %}
  <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">{{ t.translate('risk.d_env') }}</div>
  {%- for key in environmentItemKeys %}
  {{ questionGroup(key, unanswered, values) }}
  {%- endfor %}
  {% endcall %}

  {% call card('p-4') %}
  <div class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">{{ t.translate('risk.d_ext') }}</div>
  {%- for key in externalItemKeys %}
  {{ questionGroup(key, unanswered, values) }}
  {%- endfor %}
  {% endcall %}

  <div class="flex gap-3">
    <button type="submit" class="touch-target px-4 rounded bg-accent text-white text-sm font-semibold">{{ t.translate('btn.submit') }}</button>
    <a href="{{ cancelHref }}" class="touch-target inline-flex items-center px-4 rounded border border-edge text-sm text-slate-300">{{ t.translate('risk.cancel') }}</a>
  </div>
</form>
