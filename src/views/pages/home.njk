{# Home screen: the pre-flight brief (home-dashboard capability). A greeting,
   the next flight intent, a derived go/no-go decision indicator, the four
   status tiles, the weather + NOTAM region (loaded lazily via htmx — design
   decision 2), and three aircraft stat cards. The route sits behind the
   authentication wall, so a pilot is always present. Rendered fragment-only
   for htmx navigation, embedded in the shell for full-page requests — same
   partial either way (ViewRenderer contract). #}
{% from 'partials/components.njk' import pageHeader, card, emptyState, statusChip %}
{% from 'partials/home-tiles.njk' import tile %}

{{ pageHeader(title, t.translate('home.subtitle')) }}

<div class="mb-4">
  <p class="text-xs text-slate-400 font-data">{{ viewModel.dateLine }}</p>
  <h2 class="text-lg font-bold text-white">{{ t.translate(viewModel.greetingKey) }}, {{ pilot.displayName }}.</h2>
</div>

{% call card('p-4 mb-4') %}
  {%- if viewModel.intent %}
  <p class="text-[11px] uppercase tracking-wide text-slate-400 mb-1">{{ t.translate('home.next_flight_heading') }}</p>
  <div class="text-sm text-white font-data">
    {{ viewModel.intent.departureIcao }} &rarr; {{ viewModel.intent.destinationIcao }}
    {%- if viewModel.intent.aircraftRegistration %} &middot; {{ viewModel.intent.aircraftRegistration }}{% endif %}
    &middot; {{ viewModel.intent.plannedDate }}
  </div>
  {%- else %}
  {{ emptyState(t.translate('home.no_upcoming_flight'), '', 'shield') }}
  <div class="flex justify-center">
    <a href="{{ viewModel.planFlightHref }}" class="touch-target inline-flex items-center px-4 rounded bg-accent text-white text-sm font-semibold">{{ t.translate('home.plan_flight_cta') }}</a>
  </div>
  {%- endif %}

  {%- if viewModel.decision %}
  <div class="mt-3 pt-3 border-t border-edge flex flex-wrap items-center gap-2">
    <span class="text-xs text-slate-400">{{ t.translate('home.decision_heading') }}:</span>
    {%- if viewModel.decision.state === 'unassessed' %}
    {{ statusChip(t.translate('home.decision_unassessed'), 'neutral') }}
    <a href="{{ viewModel.decision.startHref }}" class="touch-target inline-flex items-center text-xs text-slate-300 underline">{{ t.translate('home.start_assessment_cta') }}</a>
    {%- else %}
    {{ statusChip(t.translate('home.verdict_' + viewModel.decision.verdict), viewModel.decision.tone) }}
    <span class="text-xs text-slate-400 font-data">{{ t.translate('home.score_label') }}: {{ viewModel.decision.overallScore }}</span>
    <span class="text-xs text-slate-400 font-data">{{ t.translate('home.assessed_at_label') }}: {{ viewModel.decision.submittedAt | intlUtcDateTime }}</span>
    {%- endif %}
  </div>
  {%- endif %}
{% endcall %}

<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
  {{ tile(t, viewModel.tiles.weather) }}
  {{ tile(t, viewModel.tiles.risk) }}
  {{ tile(t, viewModel.tiles.aircraft) }}
  {{ tile(t, viewModel.tiles.checklists) }}
</div>

<div id="home-weather-region" class="mb-4" hx-get="{{ viewModel.weatherFragmentHref }}" hx-trigger="load" hx-swap="outerHTML">
  {% call card('p-4') %}
    {%- if viewModel.intent %}
    <p class="text-sm text-slate-300">
      <a href="{{ viewModel.tiles.weather.href }}" class="touch-target inline-flex items-center underline">{{ t.translate('home.tile_weather') }} — {{ viewModel.intent.departureIcao }}</a>
    </p>
    {%- else %}
    <p class="text-sm text-slate-400">{{ t.translate('home.no_aerodrome_selected') }}</p>
    {%- endif %}
  {% endcall %}
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-3">
  {%- for stat in [viewModel.stats.fuel, viewModel.stats.maintenance, viewModel.stats.lastFlight] %}
  <a href="{{ stat.href }}" class="touch-target block p-4 bg-surface border border-edge rounded-lg">
    <div class="flex items-center justify-between gap-2 mb-1">
      <span class="text-xs font-semibold text-slate-300">{{ t.translate(stat.labelKey) }}</span>
      {%- if stat.status %}{{ statusChip(t.translate(stat.status.labelKey), stat.status.tone) }}{% endif %}
    </div>
    {%- if stat.value === null %}
    <p class="text-xs text-slate-400">{{ t.translate(stat.unavailableKey) }}</p>
    {%- else %}
    <p class="text-sm text-white font-data">{{ stat.value }}{% if stat.unit %} {{ stat.unit }}{% endif %}</p>
    {%- if stat.sub %}<p class="text-xs text-slate-400 mt-0.5">{{ stat.sub }}</p>{% endif %}
    {%- endif %}
  </a>
  {%- endfor %}
</div>
