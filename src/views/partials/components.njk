{# Shared component partials re-authored from the prototype at phone width
   first. Every interactive control carries the `touch-target` class (44px
   minimum); the component tests assert on it. #}
{% from 'partials/icons.njk' import icon %}

{% macro card(extraClass='') -%}
<div class="bg-surface border border-edge rounded-lg {{ extraClass }}">{{ caller() }}</div>
{%- endmacro %}

{% macro pageHeader(title, subtitle='') -%}
<div class="mb-6">
  <h1 class="text-xl font-bold text-white">{{ title }}</h1>
  {%- if subtitle %}<p class="text-sm text-slate-400 mt-0.5">{{ subtitle }}</p>{% endif %}
</div>
{%- endmacro %}

{% macro statusChip(label, tone='neutral') -%}
<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded border text-xs font-semibold font-data tracking-wider{% if tone === 'good' %} bg-emerald-900/50 text-emerald-300 border-emerald-700/60{% elif tone === 'warn' %} bg-amber-900/50 text-amber-300 border-amber-700/60{% elif tone === 'bad' %} bg-red-900/50 text-red-300 border-red-700/60{% elif tone === 'severe' %} bg-purple-900/50 text-purple-300 border-purple-700/60{% else %} bg-slate-800/50 text-slate-300 border-slate-700/60{% endif %}">
  <span class="w-1.5 h-1.5 rounded-full{% if tone === 'good' %} bg-emerald-400{% elif tone === 'warn' %} bg-amber-400{% elif tone === 'bad' %} bg-red-400{% elif tone === 'severe' %} bg-purple-400{% else %} bg-slate-400{% endif %}"></span>
  {{ label }}
</span>
{%- endmacro %}

{% macro badge(label, tone='neutral') -%}
<span class="text-[10px] font-bold px-1.5 py-0.5 rounded uppercase{% if tone === 'critical' %} text-red-400 bg-red-900/50{% elif tone === 'warn' %} text-amber-400 bg-amber-900/50{% else %} text-slate-300 bg-slate-800/60{% endif %}">{{ label }}</span>
{%- endmacro %}

{% macro rawPlainToggle(id, plainLabel, rawLabel, mode='plain') -%}
<div class="flex rounded overflow-hidden border border-edge text-xs" role="group" aria-label="{{ id }}">
  <button type="button" class="touch-target px-3 font-medium transition-colors{% if mode === 'plain' %} bg-accent text-white{% else %} text-slate-400 hover:text-slate-200{% endif %}">{{ plainLabel }}</button>
  <button type="button" class="touch-target px-3 font-medium transition-colors{% if mode === 'raw' %} bg-accent text-white{% else %} text-slate-400 hover:text-slate-200{% endif %}">{{ rawLabel }}</button>
</div>
{%- endmacro %}

{% macro progressBar(value, max, tone='neutral', label='') -%}
<div class="flex items-center gap-3">
  <div class="flex-1 h-1 bg-edge rounded-full overflow-hidden" role="progressbar" aria-valuenow="{{ value }}" aria-valuemin="0" aria-valuemax="{{ max }}">
    <div class="h-full rounded-full{% if tone === 'good' %} bg-emerald-500{% elif tone === 'warn' %} bg-amber-500{% elif tone === 'bad' %} bg-red-500{% else %} bg-accent{% endif %}" style="width: {{ (value / max) * 100 | round(1) }}%"></div>
  </div>
  {%- if label %}<span class="text-xs font-data text-slate-400 whitespace-nowrap">{{ label }}</span>{% endif %}
</div>
{%- endmacro %}

{% macro emptyState(title, message='', iconName='book') -%}
<div class="text-center py-10 px-4">
  <div class="w-12 h-12 mx-auto rounded-full bg-surface border border-edge flex items-center justify-center text-slate-400">
    {{ icon(iconName) }}
  </div>
  <p class="mt-3 text-sm font-semibold text-slate-300">{{ title }}</p>
  {%- if message %}<p class="mt-1 text-sm text-slate-400 max-w-md mx-auto">{{ message }}</p>{% endif %}
</div>
{%- endmacro %}
