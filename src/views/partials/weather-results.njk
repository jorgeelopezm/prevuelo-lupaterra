{# Shared partials for the weather screen's result sections: provenance/cache/
   sample-data badges and the per-indicator error state, reused across METAR,
   TAF, NOTAM, and SIGMET sections so every result kind renders provenance the
   same way.

   `t` (the request translator) and any date already run through the
   `intlUtcDateTime` filter are passed in explicitly rather than relied on
   from the calling template's context: Nunjucks filters read the top-level
   render context via `this.context`, which is not reliably available inside
   a macro imported `with context` from a separate file, so formatting stays
   in the caller and only the resulting strings cross the macro boundary. #}
{% from 'partials/components.njk' import badge %}
{% from 'partials/icons.njk' import icon %}

{% macro provenanceLine(t, provider, timeLabel, timeFormatted, retrievedFormatted, cached, cacheAgeSeconds, sample) -%}
<div class="mt-2 flex flex-wrap items-center gap-2 text-[11px] text-slate-400">
  <span>{{ t.translate('weather.provider_label') }}: {{ provider }}</span>
  <span aria-hidden="true">·</span>
  <span>{{ timeLabel }}: {{ timeFormatted }}</span>
  <span aria-hidden="true">·</span>
  <span>{{ t.translate('weather.retrieved_label') }}: {{ retrievedFormatted }}</span>
  {%- if cached %}
  {{ badge(t.translate('weather.cached_label') + ' · ' + cacheAgeSeconds + 's', 'neutral') }}
  {%- endif %}
  {%- if sample %}
  {{ badge(t.translate('weather.sample_caveat'), 'warn') }}
  {%- endif %}
</div>
{%- endmacro %}

{% macro errorBox(t, error) -%}
<div class="flex items-start gap-2 text-sm text-red-300 bg-red-900/20 border border-red-700/40 rounded p-3" role="alert">
  <span class="flex-shrink-0 mt-0.5">{{ icon('alert') }}</span>
  <div>
    <p class="font-medium">
      {%- if error.kind === 'timeout' -%}{{ t.translate('weather.error_timeout') }}
      {%- elif error.kind === 'rate_limit' -%}{{ t.translate('weather.error_rate_limit') }}
      {%- elif error.kind === 'validation' -%}{{ t.translate('weather.error_validation') }}
      {%- else -%}{{ t.translate('weather.error_provider') }}
      {%- endif -%}
      {%- if error.provider %} ({{ error.provider }}){% endif %}
    </p>
    {%- if error.kind === 'rate_limit' %}
    <p class="text-xs text-red-300/80 mt-0.5">{{ t.translate('weather.retry_hint') }}{% if error.retryAfterSeconds %} ({{ error.retryAfterSeconds }}s){% endif %}</p>
    {%- endif %}
  </div>
</div>
{%- endmacro %}

{# A NOTAM/SIGMET validity window. The caller passes each time already run
   through `intlUtcDateTime`, or `null` when the provider stated none — which
   renders the localized "not stated", never a substituted time. #}
{% macro validityLine(t, startFormatted, endFormatted) -%}
<p class="font-data text-[11px] text-slate-400">{{ t.translate('weather.validity_label') }}: {{ startFormatted if startFormatted else t.translate('weather.validity_not_stated') }} – {{ endFormatted if endFormatted else t.translate('weather.validity_not_stated') }}</p>
{%- endmacro %}

{# The empty state of a NOTAM/SIGMET list: "none in force" only when the
   provider confirmed completeness, otherwise the unconfirmed-empty notice.
   Stated in text, not by color. #}
{% macro emptyListState(t, confirmedEmpty, confirmedKey, unconfirmedKey) -%}
{%- if confirmedEmpty %}
<p class="text-sm text-slate-400">{{ t.translate(confirmedKey) }}</p>
{%- else %}
<p class="flex items-start gap-2 text-sm text-amber-200" role="note"><span class="flex-shrink-0 mt-0.5">{{ icon('alert') }}</span><span>{{ t.translate(unconfirmedKey) }}</span></p>
{%- endif %}
{%- endmacro %}

{# Link to the state's official NOTAM briefing (ENAIRE / NAV Portugal), set by
   the service only when a NOTAM list is not confirmed complete. A plain
   navigation — the application fetches nothing from it. #}
{% macro briefingLink(t, briefing) -%}
{%- if briefing %}
<a href="{{ briefing.href }}" class="touch-target inline-flex items-center mt-2 text-xs text-slate-300 underline" rel="noopener noreferrer" target="_blank">{{ t.translate(briefing.labelKey) }}</a>
{%- endif %}
{%- endmacro %}
