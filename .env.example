# Environment: development | test | production
NODE_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=3000
# Absolute external base URL used for redirects and links (no trailing slash).
PUBLIC_URL=http://localhost:3000

# PostgreSQL — matches ./docker-compose.yml for local development.
DATABASE_URL=postgres://ga:ga@localhost:5432/ga_core

# Identity / sessions
# Base64-encoded, high-entropy secret. CHANGE THIS in any non-local environment.
SESSION_SECRET=change-me-to-a-long-random-string
# Absolute session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Failed sign-in attempts allowed per account and per source within the window.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILURE_WINDOW_MINUTES=15
# Public self-registration. Off by default: the sign-in screen shows no
# sign-up link and the registration route creates no account. Every page sits
# behind sign-in, so for local work sign in as the seeded development pilot
# (npm run db:seed), or set this to true to create an account.
REGISTRATION_ENABLED=false

# Embedding provider. "mock" is the only provider implemented in this change
# and never requires a credential. A non-mock provider must supply its key.
EMBEDDING_PROVIDER=mock
# Dimensionality of the pgvector embedding column; fixed after migration 003.
EMBEDDING_DIMENSIONS=768
# EMBEDDING_API_KEY=

# Weather provider. "mock" (default, no credential) has fixture data for four
# Iberian aerodromes only. "avwx" is a real, globally-scoped provider backed by
# https://avwx.rest/api — get a free-tier token at https://account.avwx.rest
# and set AVWX_API_TOKEN. "awc" is the free, keyless aviationweather.gov Data
# API (METAR, TAF, international SIGMET worldwide) — it supplies no NOTAMs, so
# NOTAM_PROVIDER must then be set. AEMET/IPMA/EAD are named but not yet implemented.
WEATHER_PROVIDER=mock
# NOTAM source: mock | avwx. Unset, it follows WEATHER_PROVIDER (mock/avwx);
# required with WEATHER_PROVIDER=awc. NOTAM_PROVIDER=mock serves sample NOTAMs
# (labeled as such) next to real AWC weather — prefer avwx with a token.
# NOTAM_PROVIDER=
# AEMET_OPENDATA_API_KEY=
# IPMA_API_KEY=
# EAD_API_KEY=
# AVWX_API_TOKEN=

# MCP server (mcp/aviation-weather)
# Transport for the MCP server: stdio | http
MCP_TRANSPORT=stdio
# Port for the MCP HTTP transport.
MCP_PORT=3001

# Web app's MCP *client* connection to the aviation-weather server (the
# /meteorologia screen). "stdio" spawns the server as a child process; "http"
# connects to an independently-run server and requires WEATHER_MCP_URL.
WEATHER_MCP_TRANSPORT=stdio
# WEATHER_MCP_URL=http://localhost:3001/mcp
WEATHER_MCP_TIMEOUT_MS=8000

# Fleet module (/aeronave — aircraft, logbook, maintenance, engine data)
# Days before a document's expiry (or a maintenance item's due date) that it
# is flagged as "expiring soon" / "due soon".
DOCUMENT_WARNING_DAYS=30
MAINTENANCE_WARNING_DAYS=30
# Hours before a maintenance item's due-at-hours reading that it is flagged
# "due soon".
MAINTENANCE_WARNING_HOURS=10
# Maximum accepted size, in bytes, of an imported engine-monitor data file.
ENGINE_DATA_MAX_BYTES=8388608

# Logging
LOG_LEVEL=info