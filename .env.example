# Environment: development | test | production
NODE_ENV=development

# HTTP server
HOST=0.0.0.0
PORT=3000
# Absolute external base URL used for redirects and links (no trailing slash).
PUBLIC_URL=http://localhost:3000

# PostgreSQL — matches ./docker-compose.yml for local development.
DATABASE_URL=postgres://ga:ga@localhost:5432/ga_core

# Identity / sessions
# Base64-encoded, high-entropy secret. CHANGE THIS in any non-local environment.
SESSION_SECRET=change-me-to-a-long-random-string
# Absolute session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168
# Failed sign-in attempts allowed per account and per source within the window.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_FAILURE_WINDOW_MINUTES=15

# Embedding provider. "mock" is the only provider implemented in this change
# and never requires a credential. A non-mock provider must supply its key.
EMBEDDING_PROVIDER=mock
# Dimensionality of the pgvector embedding column; fixed after migration 003.
EMBEDDING_DIMENSIONS=768
# EMBEDDING_API_KEY=

# Weather provider. "mock" is the only provider implemented in this change.
# Real providers (AEMET/IPMA/EAD) are deferred with the weather capability.
WEATHER_PROVIDER=mock
# AEMET_OPENDATA_API_KEY=

# MCP server (mcp/aviation-weather)
# Transport for the MCP server: stdio | http
MCP_TRANSPORT=stdio
# Port for the MCP HTTP transport.
MCP_PORT=3001

# Logging
LOG_LEVEL=info